{
  "name": "sleepzzz",
  "version": "1.0.0",
  "description": "Baby tracker for sleep, feeds, and diapers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute sleepzzz-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute sleepzzz-db --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  }
}
